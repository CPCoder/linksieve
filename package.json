{
    "name": "linksieve",
    "version": "0.1.0",
    "description": "LinkedIn-specific browser extension for filtering jobs by external application URL.",
    "private": true,
    "type": "module",
    "license": "MIT",
    "scripts": {
        "build": "tsx scripts/build.ts",
        "build:chrome": "tsx scripts/build.ts chrome",
