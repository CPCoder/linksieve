        "typecheck": "tsc -p tsconfig.json --noEmit"
    },
    "devDependencies": {
        "@types/chrome": "^0.2.7",
        "@types/firefox-webext-browser": "^143.0.0",
        "@types/node": "^26.4.0",
        "jsdom": "^30.0.1",
        "tsx": "^4.23.13",
        "typescript": "^7.0.2",
        "vitest": "^4.1.11"
    }
