{
    "manifest_version": 3,
    "name": "LinkSieve",
    "version": "0.1.0",
    "description": "Filter LinkedIn jobs by external application URL.",
    "permissions": [
        "storage"
    ],
    "host_permissions": [
        "https://www.linkedin.com/*"
    ],
    "background": {
        "scripts": [
            "background/index.js"
        ]
    },
    "action": {
        "default_title": "LinkSieve",
        "default_popup": "popup/index.html"
    },
    "options_ui": {
        "page": "options/index.html",
        "open_in_tab": true
    },
    "content_scripts": [
        {
            "matches": [
                "https://www.linkedin.com/jobs/*"
            ],
            "js": [
                "content/main.js"
            ],
            "css": [
                "content/styles.css"
            ],
            "run_at": "document_idle"
        }
    ],
    "icons": {
        "16": "icons/icon-16.png",
        "32": "icons/icon-32.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png"
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "linksieve@shworx.de"
        }
    }
}